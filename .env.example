# InternTrack AI Environment Configuration

PORT=5000

# Google Gemini API Key (Optional: system has grounded heuristic analyzer fallback)
GEMINI_API_KEY=

# Google OAuth Credentials for Gmail API
GMAIL_CLIENT_ID=
